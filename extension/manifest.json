{
  "manifest_version": 3,
  "name": "Send to Readout",
  "short_name": "Send to Readout",
  "version": "2.1.0",
  "description": "Send the article you're reading to Readout.",
  "action": {
    "default_title": "Send to Readout",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.vercel.app/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}
