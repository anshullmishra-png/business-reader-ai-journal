# Copy to .env.local for local development (never commit real values).
# Leave TURSO_* empty to use a local file database (data/dev.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
GEMINI_API_KEY=
# Optional model overrides
GEMINI_MODEL_LIGHT=gemini-2.5-flash-lite
GEMINI_MODEL_STRONG=gemini-2.5-flash
# Friends need this code to create an account
INVITE_CODE=
# AI calls each person may make per day
AI_DAILY_LIMIT=30
# New articles per person per day, and the app-wide Gemini spend cap (USD per UTC day)
ARTICLES_PER_DAY=1
APP_DAILY_BUDGET_USD=0.50
