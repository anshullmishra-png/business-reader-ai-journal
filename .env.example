# Copy to .env.local for local development (never commit real values).
# Neon Postgres connection string (use the pooled one). Leave empty to use a
# local Postgres (PGlite) in data/pglite.
DATABASE_URL=
# Paid key (prepaid credit) and a free-tier key from a Google project without billing
GEMINI_API_KEY=
GEMINI_API_KEY_FREE=
# Optional model overrides
GEMINI_MODEL_LIGHT=gemini-3.1-flash-lite
GEMINI_MODEL_STRONG=gemini-3.6-flash
# Sign-up codes: INVITE_CODE makes a free-plan account, INVITE_CODE_PAID a paid-plan one
INVITE_CODE=
INVITE_CODE_PAID=
# Show three fictional sample articles on Today (test deployments)
SAMPLE_ARTICLES=
# AI calls each person may make per day
AI_DAILY_LIMIT=30
# New articles per person per day, and the app-wide Gemini spend cap (USD per UTC day)
ARTICLES_PER_DAY=1
APP_DAILY_BUDGET_USD=0.50
# Owner emails (comma-separated) with no per-person article or AI-call limits
OWNER_EMAILS=
# All-time Gemini spend cap (USD); raise it after topping up the prepaid credit
LIFETIME_BUDGET_USD=4.80
